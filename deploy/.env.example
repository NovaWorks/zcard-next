# 首选 bash deploy/docker-install.sh 自动生成 deploy/.env，切勿重新生成既有密钥。
# 手工配置时复制为 .env，并为每个密钥生成不同的 openssl rand -hex 32 值。
# 直接 Compose 构建时使用的发行版本；安装脚本默认解析最新正式版。
ZCARD_VERSION=latest
ZCARD_BIND=0.0.0.0
ZCARD_PORT=8000
ZCARD_JWT_ADMIN_KEY=
ZCARD_JWT_USER_KEY=
ZCARD_CARD_KEY=
ZCARD_DATA_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
