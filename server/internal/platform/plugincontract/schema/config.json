{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcard.invalid/plugin/v1/config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "enabled": {
      "type": "boolean"
    },
    "allowedLevelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "pattern": "^[1-9][0-9]{0,19}$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "enabled",
    "allowedLevelIds"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "allowedLevelIds": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
