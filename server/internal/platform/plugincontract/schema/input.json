{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcard.invalid/plugin/v1/input.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "hook": {
      "const": "order.pre_create.v1"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "subsiteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "skuId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "channel": {
      "type": "string",
      "enum": [
        "storefront",
        "supply",
        "acg",
        "dujiao"
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "effectiveLevelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "authenticated",
        "effectiveLevelId"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "authenticated": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "effectiveLevelId": {
                "const": "0"
              }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "enabled": {
          "type": "boolean"
        },
        "allowedLevelIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "revision",
        "enabled",
        "allowedLevelIds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "allowedLevelIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "hook",
    "pluginId",
    "generation",
    "subsiteId",
    "productId",
    "skuId",
    "quantity",
    "channel",
    "member",
    "config"
  ]
}
